# Copy to .env; generate a random admin token (>=32 characters). Never commit .env.
PAW_ADMIN_TOKEN=
PAW_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/paw
# If password contains reserved URL characters, omit password from the URL
# and set the actual password separately in a quoted PAW_DB_PASSWORD.
# PAW_DB_PASSWORD=
PAW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PAW_GPS_MAX_ACCURACY_M=25
PAW_MOVEMENT_THRESHOLD_M=15
PAW_GPS_MAX_AGE_SECONDS=300
PAW_STABILIZATION_SECONDS=120
PAW_OFFLINE_AFTER_SECONDS=1800
PAW_SSE_POLL_SECONDS=1
# Used only by compose.yaml; setup_env.py generates a random local password.
PAW_POSTGRES_PASSWORD=
# Offline imagery and optional same-origin Vite build serving (local paths).
PAW_IMAGERY_DIR=data/imagery
PAW_FRONTEND_DIST=../frontend/dist

# Admin-only selection of one local basemap per farm. Not editable by viewer UI.
# PAW_ACTIVE_IMAGERY_IDS={"FARM-ID":"farm-2026-v1"}

# Zero-interaction viewer: explicit read-only deployment grant, disabled by default.
# PAW_VIEWER_FARM_ID=FARM-ID
# PAW_VIEWER_NETWORKS=["192.168.1.50/32"]
# PAW_VIEWER_ORIGINS=["http://192.168.1.10:8000"]
