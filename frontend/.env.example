# VITE_* công khai trong bundle. Không lưu token, mật khẩu hoặc ingest token.
VITE_DATA_MODE=DEMO
# Chỉ đặt URL thật khi được cung cấp; không tự suy đoán host/cổng.
# VITE_API_BASE_URL=https://dia-chi-api-cua-ban
# T6 hiện chưa có hợp đồng API được xác minh. Đặt LIVE sẽ hiện trạng thái
# chưa tích hợp, không sử dụng DEMO thay thế. /health chỉ kiểm tra HTTP/JSON.


# Default: same-origin FastAPI serves the frontend build. No viewer token in frontend.
# VITE_PAW_API_URL is optional for separately hosted deployments (admin setup only).
# VITE_PAW_API_URL=http://192.168.1.10:8000
# Farm and read access are selected on the server, not in VITE variables.
